@model List<ClinicManagement.Models.Doctor>

@{
    ViewData["Title"] = "Manage Doctors";
}

<div class="idh-dashboard">

    <div class="idh-header">
        <div>
            <h1>Manage Doctors</h1>
            <div class="idh-subtitle">View and manage clinic doctors</div>
        </div>

        <div class="idh-header-actions">
            <a asp-controller="Admin" asp-action="CreateStaff" class="idh-add-btn">Add Doctor</a>
            <a asp-controller="Admin" asp-action="Dashboard" class="idh-btn-secondary">Back</a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="idh-alert-error">@TempData["Error"]</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="idh-card">
            <table class="idh-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Doctor</th>
                        <th>Email</th>
                        <th>Specialty</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var doctor in Model)
                    {
                        <tr>
                            <td class="idh-muted">@doctor.Id</td>
                            <td class="idh-patient-name">@doctor.User.Name</td>
                            <td class="idh-muted">@doctor.User.Email</td>
                            <td><span class="idh-specialty-pill">@doctor.Specialty.Name</span></td>

                            <td>
                                @if (doctor.User.IsActive)
                                {
                                    <span class="idh-badge success">Active</span>
                                }
                                else
                                {
                                    <span class="idh-badge light">Inactive</span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="idh-row-actions">

                                    @if (doctor.User.IsActive)
                                    {
                                        <form asp-controller="Admin"
                                              asp-action="DeactivateDoctor"
                                              method="post">

                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@doctor.Id" />

                                            <button type="submit" class="idh-btn-xs deactivate">Deactivate</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Admin"
                                              asp-action="ActivateDoctor"
                                              method="post">

                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@doctor.Id" />

                                            <button type="submit" class="idh-btn-xs activate">Activate</button>
                                        </form>
                                    }

                                    <form asp-controller="Admin"
                                          asp-action="DeleteDoctor"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this doctor?');">

                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@doctor.Id" />

                                        <button type="submit" class="idh-btn-xs delete">Delete</button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="idh-empty">
            <div class="idh-empty-title">No doctors found</div>
            <div class="idh-empty-desc idh-muted">There are currently no doctors in the system.</div>
            <a asp-controller="Admin" asp-action="CreateStaff" class="idh-add-btn">Add Doctor</a>
        </div>
    }

</div>
