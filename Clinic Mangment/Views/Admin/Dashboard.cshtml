@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">

    <!-- Header -->

    <div class="mb-4">

        <h2>
            Admin Dashboard
        </h2>

        <p class="text-muted">
            Manage clinic system
        </p>

    </div>


    <!-- Statistics -->

    <div class="row g-4">

        <!-- Patients -->

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Patients
                    </h6>

                    <h2>
                        @ViewBag.TotalPatients
                    </h2>

                </div>

            </div>

        </div>


        <!-- Doctors -->

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Doctors
                    </h6>

                    <h2>
                        @ViewBag.TotalDoctors
                    </h2>

                </div>

            </div>

        </div>


        <!-- Specialties -->

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        Specialties
                    </h6>

                    <h2>
                        @ViewBag.TotalSpecialties
                    </h2>

                </div>

            </div>

        </div>


        <!-- Visits -->

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Visits
                    </h6>

                    <h2>
                        @ViewBag.TotalVisits
                    </h2>

                </div>

            </div>

        </div>


        <!-- Pending -->

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        Pending Visits
                    </h6>

                    <h2>
                        @ViewBag.PendingVisits
                    </h2>

                </div>

            </div>

        </div>


        <!-- Completed -->

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        Completed Visits
                    </h6>

                    <h2>
                        @ViewBag.CompletedVisits
                    </h2>

                </div>

            </div>

        </div>

    </div>


    <!-- Management -->

    <div class="card shadow-sm mt-5">

        <div class="card-body">

            <h5>
                System Management
            </h5>


            <div class="mt-3 d-flex justify-content-between ">

                <a asp-controller="Admin"
                   asp-action="Doctors"
                   class="btn idh-submit-btn">

                    Manage Doctors

                </a>


                <a asp-controller="Admin"
                   asp-action="Specialties"
                   class="btn idh-submit-btn">

                    Manage Specialties

                </a>
                <a asp-controller="Admin"
                   asp-action="CreateStaff"
                   class="btn idh-submit-btn">

                    Create Staff

                </a>


                <a asp-controller="Admin"
                   asp-action="Users"
                   class="btn idh-submit-btn">

                    Manage Users

                </a>

            </div>

        </div>

    </div>

</div>
