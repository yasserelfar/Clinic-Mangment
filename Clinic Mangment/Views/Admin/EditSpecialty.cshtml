@model ClinicManagement.Models.Specialty

@{
    ViewData["Title"] = "Edit Specialty";
}

<div class="idh-form-page">

    <div class="idh-header">
        <div>
            <h1>Edit Specialty</h1>
            <div class="idh-subtitle">Update specialty information</div>
        </div>
        <a asp-controller="Admin"
           asp-action="Specialties"
           class="idh-btn-secondary">
            Back
        </a>
    </div>

    <div class="idh-form-card">
        <form asp-controller="Admin"
              asp-action="EditSpecialty"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.Id" />

            <div asp-validation-summary="All" class="idh-validation-summary"></div>

            <div class="idh-field">
                <label for="name">Specialty Name</label>
                <input type="text"
                       id="name"
                       name="name"
                       value="@Model.Name"
                       required />
            </div>

            <div class="idh-form-actions">
                <a asp-controller="Admin"
                   asp-action="Specialties"
                   class="idh-btn-secondary">
                    Cancel
                </a>

                <button type="submit" class="idh-submit-btn">Save Changes</button>
            </div>

        </form>
    </div>

</div>
