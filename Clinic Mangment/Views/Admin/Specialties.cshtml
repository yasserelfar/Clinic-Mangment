
@model List<ClinicManagement.Models.Specialty>

@{
    ViewData["Title"] = "Manage Specialties";
}

<div class="container mt-4">

    <!-- Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>Manage Specialties</h2>

            <p class="text-muted">
                Add, edit and manage clinic specialties
            </p>

        </div>

        <div>

            <a asp-controller="Admin"
               asp-action="CreateSpecialty"
               class="btn btn-primary">

                + Add Specialty

            </a>

            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="btn btn-secondary">

                Back

            </a>

        </div>

    </div>


    <!-- Error -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            @TempData["Error"]

        </div>
    }


    <!-- Table -->

    <div class="card shadow-sm">

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>
                                    #
                                </th>

                                <th>
                                    Specialty
                                </th>

                                <th>
                                    Doctors
                                </th>

                                <th class="text-end">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var specialty in Model)
                            {
                                <tr>

                                    <td>
                                        @specialty.Id
                                    </td>

                                    <td>

                                        <strong>
                                            @specialty.Name
                                        </strong>

                                    </td>

                                    <td>

                                        <span class="badge bg-light text-dark">

                                            @specialty.Doctors.Count

                                        </span>

                                    </td>

                                    <td class="text-end">

                                        <div class="d-flex justify-content-end gap-2">

                                            <!-- Edit -->

                                            <a asp-controller="Admin"
                                               asp-action="EditSpecialty"
                                               asp-route-id="@specialty.Id"
                                               class="btn btn-sm btn-outline-primary">

                                                Edit

                                            </a>


                                            <!-- Delete -->

                                            <form asp-controller="Admin"
                                                  asp-action="DeleteSpecialty"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this specialty?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@specialty.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">

                                                    Delete

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <h5>
                        No specialties found
                    </h5>

                    <p class="text-muted">
                        Start by adding a specialty.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="CreateSpecialty"
                       class="btn btn-primary">

                        + Add Specialty

                    </a>

                </div>
            }

        </div>

    </div>

</div>
