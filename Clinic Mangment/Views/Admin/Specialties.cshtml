@model List<ClinicManagement.Models.Specialty>

@{
    ViewData["Title"] = "Manage Specialties";
}

<div class="idh-dashboard">

    <div class="idh-header">
        <div>
            <h1>Manage Specialties</h1>
            <div class="idh-subtitle">Add, edit and manage clinic specialties</div>
        </div>

        <div class="idh-header-actions">
            <a asp-controller="Admin" asp-action="CreateSpecialty" class="idh-add-btn">Add Specialty</a>
            <a asp-controller="Admin" asp-action="Dashboard" class="idh-btn-secondary">Back</a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="idh-alert-error">@TempData["Error"]</div>
    }

    @if (Model.Any())
    {
        <div class="idh-card">
            <table class="idh-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Specialty</th>
                        <th>Doctors</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var specialty in Model)
                    {
                        <tr>
                            <td class="idh-muted">@specialty.Id</td>
                            <td class="idh-patient-name">@specialty.Name</td>
                            <td><span class="idh-badge light">@specialty.Doctors.Count</span></td>

                            <td class="text-end">
                                <div class="idh-row-actions">

                                    <a asp-controller="Admin"
                                       asp-action="EditSpecialty"
                                       asp-route-id="@specialty.Id"
                                       class="idh-btn-xs edit">
                                        Edit
                                    </a>

                                    <form asp-controller="Admin"
                                          asp-action="DeleteSpecialty"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this specialty?');">

                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@specialty.Id" />

                                        <button type="submit" class="idh-btn-xs delete">Delete</button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="idh-empty">
            <div class="idh-empty-title">No specialties found</div>
            <div class="idh-empty-desc idh-muted">Start by adding a specialty.</div>
            <a asp-controller="Admin" asp-action="CreateSpecialty" class="idh-add-btn">Add Specialty</a>
        </div>
    }

</div>
