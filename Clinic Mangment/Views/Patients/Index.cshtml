@model List<ClinicManagement.Models.Patient>

@{
    ViewData["Title"] = "Patients";
}

<h1>Patients</h1>

<a asp-action="Create">Add Patient</a>

<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Date of Birth</th>
            <th>Gender</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var patient in Model)
        {
            <tr>
                <td>@patient.Name</td>
                <td>@patient.Phone</td>
                <td>@patient.DateOfBirth.ToShortDateString()</td>
                <td>@patient.Gender</td>
            </tr>
        }

    </tbody>
</table>