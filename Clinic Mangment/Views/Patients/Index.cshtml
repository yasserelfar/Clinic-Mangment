@model List<ClinicManagement.Models.Patient>

@{
    ViewData["Title"] = "Patients";
}

<div class="idh-dashboard">

    <div class="idh-header">
        <div>
            <h1>Patients</h1>
            <div class="idh-subtitle">Integrated Diagnostics Holdings &middot; Clinic Management</div>
        </div>
        <a class="idh-add-btn" asp-action="Create">Add Patient</a>
    </div>

    @if (!Model.Any())
    {
        <div class="idh-empty">No patients registered yet.</div>
    }
    else
    {
        <div class="idh-card">
            <table class="idh-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Date of Birth</th>
                        <th>Gender</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var patient in Model)
                    {
                        <tr>
                            <td class="idh-patient-name">@patient.Name</td>
                            <td class="idh-muted">@patient.Phone</td>
                            <td class="idh-muted">@patient.DateOfBirth.ToShortDateString()</td>
                            <td>
                                <span class="idh-gender-pill @(patient.Gender == "Female" ? "female" : "male")">
                                    @patient.Gender
                                </span>
                            </td>
                            <td>
                                <a asp-controller="Patients"
                                   asp-action="History"
                                   asp-route-id="@patient.Id"
                                   class="idh-add-btn">

                                    Medical History

                                </a>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    }

</div>
