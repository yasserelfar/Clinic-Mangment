@model ClinicManagement.Models.Visit

@{
    ViewData["Title"] = "Examination";
}

<div class="idh-form-page">

    <div class="idh-header">
        <div>
            <h1>Medical Examination</h1>
            <div class="idh-subtitle">Integrated Diagnostics Holdings &middot; Clinic Management</div>
        </div>
    </div>

    <div class="idh-result-card idh-result-found">
        <div class="idh-result-title">Patient</div>

        <div class="idh-result-grid">
            <div>
                <span class="idh-result-label">Name</span>
                <span class="idh-result-value">@Model.Patient.Name</span>
            </div>
            <div>
                <span class="idh-result-label">Phone</span>
                <span class="idh-result-value">@Model.Patient.Phone</span>
            </div>
        </div>
    </div>

    <div class="idh-form-card">
        <form asp-action="Complete" method="post">

            <input type="hidden"
                   name="visitId"
                   value="@Model.Id" />

            <div class="idh-field">
                <label>Diagnosis</label>
                <textarea name="diagnosisText"
                          rows="5"
                          placeholder="Enter diagnosis details"
                          required></textarea>
            </div>

            <div class="idh-field">
                <label>Notes</label>
                <textarea name="notes"
                          rows="5"
                          placeholder="Additional notes (optional)"></textarea>
            </div>

            <button type="submit" class="idh-submit-btn">Confirm Examination</button>

        </form>
    </div>

</div>
