@model ClinicManagement.Models.Patient

@{
    ViewData["Title"] = "Create Visit";
}

<div class="idh-form-page">

    <div class="idh-header">
        <div>
            <h1>Create Visit</h1>
            <div class="idh-subtitle">Integrated Diagnostics Holdings &middot; Clinic Management</div>
        </div>
    </div>

    <div class="idh-result-card idh-result-found">
        <div class="idh-result-title">Patient Information</div>

        <div class="idh-result-grid">
            <div>
                <span class="idh-result-label">Name</span>
                <span class="idh-result-value">@Model.Name</span>
            </div>
            <div>
                <span class="idh-result-label">Phone</span>
                <span class="idh-result-value">@Model.Phone</span>
            </div>
        </div>
    </div>

    <div class="idh-form-card">
        <form asp-action="Create" method="post">

            <input type="hidden"
                   name="patientId"
                   value="@Model.Id" />

            <div class="idh-field">
                <label>Specialty</label>

                <select id="specialtyId" name="specialtyId">
                    <option value="">Select Specialty</option>

                    @foreach (var specialty in ViewBag.Specialties)
                    {
                        <option value="@specialty.Id">
                            @specialty.Name
                        </option>
                    }
                </select>
            </div>

            <div class="idh-field">
                <label>Doctor</label>

                <select id="doctorId"
                        name="doctorId"
                        disabled>

                    <option value="">
                        Select Doctor
                    </option>

                </select>
            </div>

            <button type="submit" class="idh-submit-btn">Create Visit</button>

        </form>
    </div>

</div>

@section Scripts {
    <script>

        const specialtySelect =
            document.getElementById("specialtyId");

        const doctorSelect =
            document.getElementById("doctorId");


        specialtySelect.addEventListener("change", async function() {

            const specialtyId = this.value;

            doctorSelect.innerHTML =
                '<option value="">Select Doctor</option>';

            doctorSelect.disabled = true;


            if (!specialtyId) {
                return;
            }


            const response =
                await fetch(`/Doctors/BySpecialty?specialtyId=${specialtyId}`);


            const doctors = await response.json();


            doctors.forEach(doctor => {

                const option =
                    document.createElement("option");

                option.value = doctor.id;
                option.textContent = doctor.name;

                doctorSelect.appendChild(option);
            });


            doctorSelect.disabled = false;

        });

    </script>
}
