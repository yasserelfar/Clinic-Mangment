@model ClinicManagement.Models.Patient

@{
    ViewData["Title"] = "Create Visit";
}

<div class="idh-form-page">

    <div class="idh-header">
        <div>
            <h1>Create Visit</h1>
            <div class="idh-subtitle">Integrated Diagnostics Holdings &middot; Clinic Management</div>
        </div>
    </div>

    <div class="idh-result-card idh-result-found">
        <div class="idh-result-title">Patient Information</div>

        <div class="idh-result-grid">
            <div>
                <span class="idh-result-label">Name</span>
                <span class="idh-result-value">@Model.Name</span>
            </div>
            <div>
                <span class="idh-result-label">Phone</span>
                <span class="idh-result-value">@Model.Phone</span>
            </div>
        </div>
    </div>

    <div class="idh-form-card">
        <form asp-action="Create" method="post" id="idh-create-visit-form">

            <input type="hidden"
                   name="patientId"
                   value="@Model.Id" />

            <div class="idh-field">
                <label>Specialty</label>

                <select id="specialtyId" name="specialtyId" required>
                    <option value="">Select Specialty</option>

                    @foreach (var specialty in ViewBag.Specialties)
                    {
                        <option value="@specialty.Id">
                            @specialty.Name
                        </option>
                    }
                </select>
            </div>

            <div class="idh-field">
                <label>Doctor</label>

                <div class="idh-select-wrap" >
                    <select id="doctorId"
                            name="doctorId"
                            disabled required>

                        <option value="">
                            Select Doctor
                        </option>

                    </select>
                    <span id="doctorSpinner" class="idh-select-spinner" hidden></span>
                </div>
            </div>

            <button type="submit" class="idh-submit-btn" id="idh-submit-visit-btn">
                <span class="idh-btn-label">Create Visit</span>
            </button>

        </form>
    </div>

</div>

@section Scripts {
    <script>
        (function () {
            const specialtySelect = document.getElementById("specialtyId");
            const doctorSelect = document.getElementById("doctorId");
            const doctorSpinner = document.getElementById("doctorSpinner");
            const form = document.getElementById("idh-create-visit-form");
            const submitBtn = document.getElementById("idh-submit-visit-btn");

            specialtySelect.addEventListener("change", async function () {
                const specialtyId = this.value;

                doctorSelect.innerHTML = '<option value="">Select Doctor</option>';
                doctorSelect.disabled = true;
                doctorSelect.classList.remove("idh-fade-in");

                if (!specialtyId) {
                    doctorSpinner.hidden = true;
                    return;
                }

                doctorSpinner.hidden = false;

                try {
                    const response = await fetch(`/Doctors/BySpecialty?specialtyId=${specialtyId}`);
                    if (!response.ok) throw new Error("Request failed");
                    const doctors = await response.json();

                    if (doctors.length === 0) {
                        doctorSelect.innerHTML = '<option value="">No doctors available</option>';
                    } else {
                        doctors.forEach(doctor => {
                            const option = document.createElement("option");
                            option.value = doctor.id;
                            option.textContent = doctor.name;
                            doctorSelect.appendChild(option);
                        });
                    }

                    doctorSelect.disabled = false;
                    // restart the fade-in animation
                    void doctorSelect.offsetWidth;
                    doctorSelect.classList.add("idh-fade-in");
                } catch (err) {
                    doctorSelect.innerHTML = '<option value="">Failed to load doctors</option>';
                    if (window.IDHToast) {
                        window.IDHToast.show("Couldn't load doctors for this specialty. Try again.", "error");
                    }
                } finally {
                    doctorSpinner.hidden = true;
                }
            });

            form.addEventListener("submit", function () {
                if (!doctorSelect.value) return; // let normal validation handle it
                submitBtn.disabled = true;
                submitBtn.classList.add("idh-btn-loading");
                submitBtn.querySelector(".idh-btn-label").textContent = "Creating visit...";
            });
        })();
    </script>
}