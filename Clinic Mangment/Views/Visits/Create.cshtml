@model ClinicManagement.Models.Patient

@{
    ViewData["Title"] = "Create Visit";
}

<h1>Create Visit</h1>

<h3>Patient Information</h3>

<p>
    <strong>Name:</strong>
    @Model.Name
</p>

<p>
    <strong>Phone:</strong>
    @Model.Phone
</p>

<hr />

<form asp-action="Create" method="post">

    <input type="hidden"
           name="patientId"
           value="@Model.Id" />

    <div>
        <label>Specialty</label>

        <select id="specialtyId" name="specialtyId">
            <option value="">Select Specialty</option>

            @foreach (var specialty in ViewBag.Specialties)
            {
                <option value="@specialty.Id">
                    @specialty.Name
                </option>
            }
        </select>
    </div>

    <br />

    <div>
        <label>Doctor</label>

        <select id="doctorId"
                name="doctorId"
                disabled>

            <option value="">
                Select Doctor
            </option>

        </select>
    </div>

    <br />

    <button type="submit">
        Create Visit
    </button>

</form>
@section Scripts {
    <script>

        const specialtySelect =
            document.getElementById("specialtyId");

        const doctorSelect =
            document.getElementById("doctorId");


        specialtySelect.addEventListener("change", async function() {

            const specialtyId = this.value;

            doctorSelect.innerHTML =
                '<option value="">Select Doctor</option>';

            doctorSelect.disabled = true;


            if (!specialtyId) {
                return;
            }


            const response =
                await fetch(`/Doctors/BySpecialty?specialtyId=${specialtyId}`);


            const doctors = await response.json();


            doctors.forEach(doctor => {

                const option =
                    document.createElement("option");

                option.value = doctor.id;
                option.textContent = doctor.name;

                doctorSelect.appendChild(option);
            });


            doctorSelect.disabled = false;

        });

    </script>
}