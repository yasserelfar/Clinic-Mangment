
@model ClinicManagement.Models.Visit

@{
    ViewData["Title"] = "Visit Details";

    var statusClass = Model.Status.ToString().ToLower() switch
    {
        "pending" => "pending",
        "inprogress" or "in progress" => "inprogress",
        "completed" => "completed",
        "cancelled" or "canceled" => "cancelled",
        _ => "pending"
    };
}

<div class="idh-form-page">

    
    <!-- Header -->
    

    <div class="idh-header">

        <div>

            <h1>Visit Details</h1>

            <div class="idh-subtitle">
                Integrated Diagnostics Holdings &middot; Clinic Management
            </div>

        </div>

        <span class="idh-status-pill @statusClass">
            @Model.Status
        </span>

    </div>


    
    <!-- Patient Information -->
    

    <div class="idh-result-card idh-result-found">

        <div class="idh-result-title">
            Patient Information
        </div>

        <div class="idh-result-grid">

            <div>

                <span class="idh-result-label">
                    Name
                </span>

                <span class="idh-result-value">
                    @Model.Patient.Name
                </span>

            </div>


            <div>

                <span class="idh-result-label">
                    Phone
                </span>

                <span class="idh-result-value">
                    @Model.Patient.Phone
                </span>

            </div>


            <div>

                <span class="idh-result-label">
                    Gender
                </span>

                <span class="idh-gender-pill @(Model.Patient.Gender == "Female" ? "female" : "male")">
                    @Model.Patient.Gender
                </span>

            </div>


            <div>

                <span class="idh-result-label">
                    Date of Birth
                </span>

                <span class="idh-result-value">
                    @Model.Patient.DateOfBirth.ToString("dd/MM/yyyy")
                </span>

            </div>

        </div>

    </div>


    
    <!-- Visit Information -->
    

    <div class="idh-result-card idh-result-found">

        <div class="idh-result-title">
            Visit Information
        </div>

        <div class="idh-result-grid">

            <!-- Specialty -->

            <div>

                <span class="idh-result-label">
                    Specialty
                </span>

                <span class="idh-result-value">
                    @Model.Specialty.Name
                </span>

            </div>


            <!-- Doctor -->

            <div>

                <span class="idh-result-label">
                    Doctor
                </span>

                <span class="idh-result-value">
                    @Model.Doctor.User.Name
                </span>

            </div>


            <!-- Status -->

            <div>

                <span class="idh-result-label">
                    Status
                </span>

                <span class="idh-status-pill @statusClass">
                    @Model.Status
                </span>

            </div>


            <!-- Created At -->

            <div>

                <span class="idh-result-label">
                    Created At
                </span>

                <span class="idh-result-value">
                    @(Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                </span>

            </div>


            <!-- Started At -->

            <div>

                <span class="idh-result-label">
                    Started At
                </span>

                <span class="idh-result-value">

                    @if (Model.StartedAt.HasValue)
                    {
                        @Model.StartedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    }
                    else
                    {
                        <span class="text-muted">
                            Not started
                        </span>
                    }

                </span>

            </div>


            <!-- Completed At -->

            <div>

                <span class="idh-result-label">
                    Completed At
                </span>

                <span class="idh-result-value">

                    @if (Model.CompletedAt.HasValue)
                    {
                        @Model.CompletedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    }
                    else
                    {
                        <span class="text-muted">
                            Not completed
                        </span>
                    }

                </span>

            </div>

        </div>

    </div>


    
    <!-- Diagnosis -->
    
    @if (Model.Diagnosis != null)
    {
        <div class="idh-result-card idh-result-found">

            <div class="idh-result-title">
                Diagnosis
            </div>

            <div class="idh-result-grid">

                <div>

                    <span class="idh-result-label">
                        Diagnosis
                    </span>

                    <span class="idh-result-value">
                        @Model.Diagnosis.DiagnosisText
                    </span>

                </div>


                @if (!string.IsNullOrWhiteSpace(Model.Diagnosis.Notes))
                {
                    <div>

                        <span class="idh-result-label">
                            Notes
                        </span>

                        <span class="idh-result-value">
                            @Model.Diagnosis.Notes
                        </span>

                    </div>
                }


                <div>

                    <span class="idh-result-label">
                        Diagnosis Created At
                    </span>

                    <span class="idh-result-value">
                        @(Model.Diagnosis.CreatedAt
                            .ToLocalTime()
                            .ToString("dd/MM/yyyy HH:mm"))
                    </span>

                </div>

            </div>

        </div>
    }



    <!-- Attachments -->
@if (Model.Attachments != null && Model.Attachments.Any())
{
    <div class="idh-attachments-grid">

        @foreach (var attachment in Model.Attachments)
        {
            var isPdf = attachment.ContentType
                .Equals(
                    "application/pdf",
                    StringComparison.OrdinalIgnoreCase
                );

            <div class="idh-attachment-card">

                <div class="idh-attachment-icon @(isPdf ? "pdf" : "image")">
                    @if (isPdf)
                    {
                        <span class="idh-attachment-icon-text">PDF</span>
                    }
                    else
                    {
                        <span class="idh-attachment-icon-text">IMG</span>
                    }
                </div>

                <div class="idh-attachment-info">

                    <div class="idh-attachment-name"
                         title="@attachment.FileName">
                        @attachment.FileName
                    </div>

                    <div class="idh-attachment-meta">
                        @(Math.Round(
                            attachment.FileSize / 1024.0 / 1024.0,
                            2
                        )) MB

                        <span>•</span>

                        @attachment.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    </div>

                </div>

               <div class="idh-attachment-actions">

    <a href="@attachment.FilePath"
       target="_blank"
       rel="noopener noreferrer"
       class="idh-attachment-view">
        View
    </a>

    <button type="button"
            class="idh-attachment-delete"
            data-id="@attachment.Id">
        Delete
    </button>

</div>

            </div>
        }

    </div>
}
else
{
    <div class="idh-attachments-empty">

        <div class="idh-empty-icon">
            +
        </div>

        <div>

            <div class="idh-empty-title">
                No medical attachments
            </div>

            <div class="idh-empty-text">
                X-Rays, analyses and medical reports uploaded
                for this visit will appear here.
            </div>

        </div>

    </div>
}

<!-- Actions -->
    <div class="mt-4">

        <a asp-controller="Visits"
           asp-action="Index"
           class="btn btn-secondary">

            Back to Visits

        </a>

    </div>

</div>
@section Scripts{
    <script>

document.addEventListener("click", async function (e) {

    const deleteButton =
        e.target.closest(".idh-attachment-delete");

    if (!deleteButton) {
        return;
    }

    const attachmentId =
        deleteButton.dataset.id;

    const confirmed =
        confirm(
            "Are you sure you want to delete this attachment?"
        );

    if (!confirmed) {
        return;
    }

    deleteButton.disabled = true;

    deleteButton.textContent = "Deleting...";


    const token =
        document.querySelector(
            'input[name="__RequestVerificationToken"]'
        ).value;


    const formData =
        new FormData();

    formData.append(
        "id",
        attachmentId
    );

    formData.append(
        "__RequestVerificationToken",
        token
    );


    try {

        const response =
            await fetch(
                "/Visits/DeleteAttachment",
                {
                    method: "POST",
                    body: formData
                }
            );


        const result =
            await response.json();


        if (!response.ok ||
            !result.success) {

            throw new Error(
                result.message ||
                "Delete failed."
            );

        }


        // Remove the card immediately

        const card =
            deleteButton.closest(
                ".idh-attachment-card"
            );


        if (card) {
            card.remove();
        }


        // If no attachments remain,
        // show empty message

        const grid =
            document.querySelector(
                ".idh-attachments-grid"
            );


        if (grid &&
            grid.children.length === 0) {

            grid.remove();


            const emptyMessage =
                document.createElement("div");

            emptyMessage.className =
                "idh-attachments-empty";

            emptyMessage.innerHTML = `
                <div class="idh-empty-icon">
                    +
                </div>

                <div>
                    <div class="idh-empty-title">
                        No medical attachments
                    </div>

                    <div class="idh-empty-text">
                        X-Rays, analyses and medical reports uploaded
                        for this visit will appear here.
                    </div>
                </div>
            `;


            const uploadCard =
                document.querySelector(
                    ".idh-result-card"
                );


            uploadCard.parentNode.insertBefore(
                emptyMessage,
                uploadCard
            );
        }

    }
    catch (error) {

        console.error(error);

        alert(
            error.message ||
            "Something went wrong while deleting."
        );


        deleteButton.disabled = false;

        deleteButton.textContent =
            "Delete";
    }

});

</script>
}