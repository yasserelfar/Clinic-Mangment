@model List<ClinicManagement.Models.Visit>

@{
    ViewData["Title"] = "Visits";

    string StatusClass(object status) => status.ToString()!.ToLower() switch
    {
        "pending" => "pending",
        "inprogress" or "in progress" => "inprogress",
        "completed" => "completed",
        "cancelled" or "canceled" => "cancelled",
        _ => "pending"
    };
}

<div class="idh-dashboard">

    <div class="idh-header">
        <div>
            <h1>Visits</h1>
            <div class="idh-subtitle">Integrated Diagnostics Holdings &middot; Clinic Management</div>
        </div>
        <a class="idh-add-btn" asp-action="Create">Add Visit</a>
    </div>

    @if (!Model.Any())
    {
        <div class="idh-empty">No visits recorded yet.</div>
    }
    else
    {
        <div class="idh-card">
            <table class="idh-table">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Specialty</th>
                        <th>Doctor</th>
                        <th>Status</th>
                        <th>Created At</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var visit in Model)
                    {
                        <tr>
                            <td class="idh-patient-name">
                                @visit.Patient.Name
                            </td>

                            <td>
                                <span class="idh-specialty-pill">@visit.Specialty.Name</span>
                            </td>

                            <td class="idh-muted">
                                @visit.Doctor.User.Name
                            </td>

                            <td>
                                <span class="idh-status-pill @StatusClass(visit.Status)">@visit.Status</span>
                            </td>

                            <td class="idh-muted">
                                @visit.CreatedAt
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    }

</div>
