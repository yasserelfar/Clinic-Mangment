@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - IDH Clinic Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background: var(--idh-gray);">

    <div class="idh-login-page">
        <div class="idh-login-card">

            <div class="idh-login-brand">
                <span class="idh-dot"></span>
                <span>Integrated Diagnostics Holdings</span>
            </div>

            <h1>Welcome back</h1>
            <p class="idh-subtitle">Sign in to access the Clinic Management System</p>

            <div asp-validation-summary="All" class="idh-validation-summary"></div>

            <form asp-action="Login" method="post">

                <div class="idh-field">
                    <label>Email</label>
                    <input type="email"
                           name="email"
                           placeholder="you@idhcorp.com"
                           required />
                </div>

                <div class="idh-field">
                    <label>Password</label>
                    <input type="password"
                           name="password"
                           placeholder="Enter your password"
                           required />
                </div>

                <button type="submit" class="idh-submit-btn">Login</button>

            </form>

        </div>
    </div>

</body>
</html>
