<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IDH Clinic Management</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Clinic_Mangment.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
       
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark idh-navbar mb-3">

            <div class="container-fluid">

                <!-- ================================================= -->
                <!-- Brand -->
                <!-- ================================================= -->

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    Clinic Management

                </a>


                <!-- ================================================= -->
                <!-- Mobile Toggle -->
                <!-- ================================================= -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- ================================================= -->
                <!-- Navbar Content -->
                <!-- ================================================= -->

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <!-- ================================================= -->
                        <!-- Home -->
                        <!-- ================================================= -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        @if (User.Identity?.IsAuthenticated == true)
                        {

                            <!-- ================================================= -->
                            <!-- ADMIN -->
                            <!-- ================================================= -->
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Admin"
                                       asp-action="Dashboard">

                                        Dashboard

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Admin"
                                       asp-action="Doctors">

                                        Doctors

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Admin"
                                       asp-action="Specialties">

                                        Specialties

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Admin"
                                       asp-action="Users">

                                        Users

                                    </a>

                                </li>
                            }


                            <!-- ================================================= -->
                            <!-- DOCTOR -->
                            <!-- ================================================= -->
                            @if (User.IsInRole("Doctor"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Doctors"
                                       asp-action="Dashboard">

                                        Dashboard

                                    </a>

                                </li>
                            }


                            <!-- ================================================= -->
                            <!-- RECEPTION -->
                            <!-- ================================================= -->
                            @if (User.IsInRole("Reception"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Reception"
                                       asp-action="Dashboard">

                                        Dashboard

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Patients"
                                       asp-action="Index">

                                        Patients

                                    </a>

                                </li>


                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Patients"
                                       asp-action="Search">

                                        Search Patient

                                    </a>

                                </li>
                            }

                        }

                    </ul>


                    <!-- ================================================= -->
                    <!-- Right Side -->
                    <!-- ================================================= -->

                    <ul class="navbar-nav">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- User Name -->

                            <li class="nav-item">

                                <span class="nav-link">

                                    @User.Identity.Name

                                </span>

                            </li>


                            <!-- Logout -->

                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-link nav-link">

                                        Logout

                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <!-- Login -->

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Login

                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>
     
    </header>
    <div class="container">
        <main role="main" class="pb-3 idh-main">
            @RenderBody()
        </main>
    </div>

    <footer class="idh-footer">
        <div class="container">
            &copy; 2026 - Clinic Management &middot; Integrated Diagnostics Holdings - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
