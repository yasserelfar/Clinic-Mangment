@model List<ClinicManagement.Models.Visit>

@{
    ViewData["Title"] = "Reception Dashboard";
}

<div class="idh-dashboard">

    <div class="idh-header">
        <div>
            <h1>Reception Dashboard</h1>
            <div class="idh-subtitle">Manage patients and visits</div>
        </div>

        <a asp-controller="Patients" asp-action="Search" class="idh-add-btn">New Visit</a>
    </div>

    <div class="idh-stat-grid">

        <div class="idh-stat-card">
            <div class="idh-stat-label">Today's Visits</div>
            <div class="idh-stat-value">@ViewBag.TotalToday</div>
        </div>

        <div class="idh-stat-card pending">
            <div class="idh-stat-label">Pending Visits</div>
            <div class="idh-stat-value">@ViewBag.PendingVisits</div>
        </div>

        <div class="idh-stat-card completed">
            <div class="idh-stat-label">Completed Visits</div>
            <div class="idh-stat-value">@ViewBag.CompletedVisits</div>
        </div>

    </div>

    <div class="idh-panel">
        <div class="idh-panel-header">
            <h2>Recent Visits</h2>
            <a asp-controller="Visits" asp-action="Index" class="idh-btn-secondary">View All</a>
        </div>

        @if (Model != null && Model.Any())
        {
            <table class="idh-table">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Specialty</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var visit in Model)
                    {
                        <tr>
                            <td>
                                <div class="idh-patient-name">@visit.Patient.Name</div>
                                <div class="idh-muted">@visit.Patient.Phone</div>
                            </td>

                            <td class="idh-muted">@visit.Doctor.User.Name</td>

                            <td><span class="idh-specialty-pill">@visit.Specialty.Name</span></td>

                            <td>
                                @if (visit.Status == ClinicManagement.Enums.VisitStatus.Pending)
                                {
                                    <span class="idh-status-pill pending">Pending</span>
                                }
                                else if (visit.Status == ClinicManagement.Enums.VisitStatus.InProgress)
                                {
                                    <span class="idh-status-pill inprogress">In Progress</span>
                                }
                                else if (visit.Status == ClinicManagement.Enums.VisitStatus.Completed)
                                {
                                    <span class="idh-status-pill completed">Completed</span>
                                }
                            </td>

                            <td class="idh-muted">
                                @visit.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                <a asp-controller="Visits"
                                   asp-action="Details"
                                   asp-route-id="@visit.Id"
                                   class="idh-btn-xs edit">
                                    View
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        }
        else
        {
            <div class="idh-empty">No visits found.</div>
        }
    </div>

    <div class="idh-panel">
        <div class="idh-panel-header">
            <h2>Quick Actions</h2>
        </div>

        <div class="idh-quick-links">
            <a asp-controller="Patients" asp-action="Search" class="idh-add-btn">New Visit</a>
            <a asp-controller="Patients" asp-action="Index" class="idh-btn-secondary">Patients</a>
        </div>
    </div>

</div>
