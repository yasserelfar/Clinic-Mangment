@{
    ViewData["Title"] = "Reception Dashboard";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Reception Dashboard</h2>

            <p class="text-muted">
                Manage patients and visits
            </p>
        </div>

        <a asp-controller="Reception"
           asp-action="CreateVisit"
           class="btn btn-primary">

            + New Visit

        </a>

    </div>


    <div class="row g-4">

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        Today's Visits
                    </h6>

                    <h2>
                        @ViewBag.TotalToday
                    </h2>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        Pending Visits
                    </h6>

                    <h2>
                        @ViewBag.PendingVisits
                    </h2>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        Completed Visits
                    </h6>

                    <h2>
                        @ViewBag.CompletedVisits
                    </h2>

                </div>

            </div>

        </div>

    </div>


    <div class="card shadow-sm mt-5">

        <div class="card-body">

            <h5>Quick Actions</h5>

            <div class="mt-3">

                <a asp-controller="Reception"
                   asp-action="CreateVisit"
                   class="btn btn-primary me-2">

                    New Visit

                </a>

                <a asp-controller="Patients"
                   asp-action="Index"
                   class="btn btn-secondary">

                    Patients

                </a>

            </div>

        </div>

    </div>

</div>