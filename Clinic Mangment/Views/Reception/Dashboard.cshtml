
@model List<ClinicManagement.Models.Visit>

@{
    ViewData["Title"] = "Reception Dashboard";
}

<div class="container mt-4">

    <!-- =====================================================
         Header
    ====================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2>Reception Dashboard</h2>

            <p class="text-muted">
                Manage patients and visits
            </p>

        </div>


        <a asp-controller="Patients"
           asp-action="Search"
           class="btn btn-primary">

            + New Visit

        </a>

    </div>


    <!-- =====================================================
         Statistics
    ====================================================== -->

    <div class="row g-4">

        <!-- Today's Visits -->

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        Today's Visits
                    </h6>

                    <h2>
                        @ViewBag.TotalToday
                    </h2>

                </div>

            </div>

        </div>


        <!-- Pending -->

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        Pending Visits
                    </h6>

                    <h2>
                        @ViewBag.PendingVisits
                    </h2>

                </div>

            </div>

        </div>


        <!-- Completed -->

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        Completed Visits
                    </h6>

                    <h2>
                        @ViewBag.CompletedVisits
                    </h2>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         Recent Visits
    ====================================================== -->

    <div class="card shadow-sm mt-5">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="mb-0">
                    Recent Visits
                </h5>

                <a asp-controller="Visits"
                   asp-action="Index"
                   class="btn btn-sm btn-outline-secondary">

                    View All

                </a>

            </div>


            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Patient
                                </th>

                                <th>
                                    Doctor
                                </th>

                                <th>
                                    Specialty
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Created
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var visit in Model)
                            {
                                <tr>

                                    <!-- Patient -->

                                    <td>

                                        <strong>
                                            @visit.Patient.Name
                                        </strong>

                                        <br />

                                        <small class="text-muted">
                                            @visit.Patient.Phone
                                        </small>

                                    </td>


                                    <!-- Doctor -->

                                    <td>

                                        @visit.Doctor.User.Name

                                    </td>


                                    <!-- Specialty -->

                                    <td>

                                        @visit.Specialty.Name

                                    </td>


                                    <!-- Status -->

                                    <td>

                                        @if (visit.Status == ClinicManagement.Enums.VisitStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (visit.Status == ClinicManagement.Enums.VisitStatus.InProgress)
                                        {
                                            <span class="badge bg-info text-dark">
                                                In Progress
                                            </span>
                                        }
                                        else if (visit.Status == ClinicManagement.Enums.VisitStatus.Completed)
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }

                                    </td>


                                    <!-- Created -->

                                    <td>

                                        @visit.CreatedAt
                                        .ToLocalTime()
                                        .ToString("dd/MM/yyyy HH:mm")

                                    </td>


                                    <!-- Action -->

                                    <td>

                                        <a asp-controller="Visits"
                                           asp-action="Details"
                                           asp-route-id="@visit.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            View

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <p class="text-muted mb-0">
                        No visits found.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- =====================================================
         Quick Actions
    ====================================================== -->

    <div class="card shadow-sm mt-4">

        <div class="card-body">

            <h5>
                Quick Actions
            </h5>


            <div class="mt-3">

                <a asp-controller="Patients"
                   asp-action="Search"
                   class="btn btn-primary me-2">

                    New Visit

                </a>


                <a asp-controller="Patients"
                   asp-action="Index"
                   class="btn btn-secondary">

                    Patients

                </a>

            </div>

        </div>

    </div>

</div>
