@model List<ClinicManagement.Models.Visit>

@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Doctor Dashboard</h2>
            <p class="text-muted">
                Pending visits waiting for examination
            </p>
        </div>

        <div>
            <strong>@User.Identity?.Name</strong>
        </div>
    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No pending visits at the moment.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-header">
                <h5 class="mb-0">
                    Pending Visits
                </h5>
            </div>

            <div class="card-body p-0">

                <table class="table table-hover mb-0">

                    <thead>
                        <tr>
                            <th>Visit #</th>
                            <th>Patient</th>
                            <th>Specialty</th>
                            <th>Created At</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var visit in Model)
                        {
                            <tr>

                                <td>
                                    #@visit.Id
                                </td>

                                <td>
                                    @visit.Patient.Name
                                </td>

                                <td>
                                    @visit.Specialty.Name
                                </td>

                                <td>
                                    @visit.CreatedAt.ToLocalTime()
                                </td>

                                <td>

                                    <a asp-controller="Doctors"
                                       asp-action="Complete"
                                       asp-route-id="@visit.Id"
                                       class="btn btn-primary btn-sm">
                                        Start Examination
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>