@model List<ClinicManagement.Models.Visit>

@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="idh-dashboard">

    <div class="idh-header">
        <div>
            <h1>Doctor Dashboard</h1>
            <div class="idh-subtitle">Pending visits waiting for examination</div>
        </div>

        <div class="idh-badge dark">@User.Identity?.Name</div>
    </div>

    @if (!Model.Any())
    {
        <div class="idh-alert-info">No pending visits at the moment.</div>
    }
    else
    {
        <div class="idh-panel">
            <div class="idh-panel-header">
                <h2>Pending Visits</h2>
            </div>

            <table class="idh-table">
                <thead>
                    <tr>
                        <th>Visit #</th>
                        <th>Patient</th>
                        <th>Specialty</th>
                        <th>Created At</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var visit in Model)
                    {
                        <tr>

                            <td class="idh-muted">#@visit.Id</td>

                            <td class="idh-patient-name">@visit.Patient.Name</td>

                            <td><span class="idh-specialty-pill">@visit.Specialty.Name</span></td>

                            <td class="idh-muted">@visit.CreatedAt.ToLocalTime()</td>

                            <td>
                                <a asp-controller="Doctors"
                                   asp-action="Complete"
                                   asp-route-id="@visit.Id"
                                   class="idh-open-btn">
                                    Start Examination
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>
            </table>
        </div>
    }

</div>
