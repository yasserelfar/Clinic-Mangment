@model ClinicManagement.Models.Visit

@{
    ViewData["Title"] = "Patient Examination";

    var statusClass = Model.Status.ToString().ToLower() switch
    {
        "pending" => "pending",
        "inprogress" or "in progress" => "inprogress",
        "completed" => "completed",
        "cancelled" or "canceled" => "cancelled",
        _ => "pending"
    };
}

<div class="idh-form-page">

    <div class="idh-header">
        <div>
            <h1>Patient Examination</h1>
            <div class="idh-subtitle">Visit #@Model.Id</div>
        </div>

        <a asp-controller="Doctors"
           asp-action="Dashboard"
           class="idh-btn-secondary">
            Back to Dashboard
        </a>
    </div>

    <!-- Patient Information -->
    <div class="idh-panel">
        <div class="idh-panel-header">
            <h2>Patient Information</h2>
        </div>

        <div class="idh-result-grid">
            <div>
                <span class="idh-result-label">Name</span>
                <span class="idh-result-value">@Model.Patient.Name</span>
            </div>
            <div>
                <span class="idh-result-label">Phone</span>
                <span class="idh-result-value">@Model.Patient.Phone</span>
            </div>
            <div>
                <span class="idh-result-label">Gender</span>
                <span class="idh-gender-pill @(Model.Patient.Gender == "Female" ? "female" : "male")">
                    @Model.Patient.Gender
                </span>
            </div>
            <div>
                <span class="idh-result-label">Date of Birth</span>
                <span class="idh-result-value">@Model.Patient.DateOfBirth.ToString("dd/MM/yyyy")</span>
            </div>
            <div>
                <span class="idh-result-label">Address</span>
                <span class="idh-result-value">
                    @(string.IsNullOrWhiteSpace(Model.Patient.Address)
                        ? "Not provided"
                        : Model.Patient.Address)
                </span>
            </div>
        </div>
    </div>

    <!-- Visit Information -->
    <div class="idh-panel">
        <div class="idh-panel-header">
            <h2>Visit Information</h2>
        </div>

        <div class="idh-result-grid">
            <div>
                <span class="idh-result-label">Specialty</span>
                <span class="idh-specialty-pill">@Model.Specialty.Name</span>
            </div>
            <div>
                <span class="idh-result-label">Visit Status</span>
                <span class="idh-status-pill @statusClass">@Model.Status</span>
            </div>
            <div>
                <span class="idh-result-label">Started At</span>
                <span class="idh-result-value">
                    @if (Model.StartedAt.HasValue)
                    {
                        @Model.StartedAt.Value.ToLocalTime()
                    }
                    else
                    {
                        <span class="idh-muted">Not started</span>
                    }
                </span>
            </div>
        </div>
    </div>

    <!-- Diagnosis -->
    <div class="idh-form-card">
        <div class="idh-panel-header" style="margin-bottom: 20px;">
            <h2>Diagnosis</h2>
        </div>

        <form asp-controller="Visits"
              asp-action="Complete"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="visitId" value="@Model.Id" />

            <div class="idh-field">
                <label for="diagnosisText">Diagnosis</label>
                <textarea id="diagnosisText"
                          name="diagnosisText"
                          rows="5"
                          placeholder="Enter patient's diagnosis..."
                          required></textarea>
            </div>

            <div class="idh-field">
                <label for="notes">Notes</label>
                <textarea id="notes"
                          name="notes"
                          rows="4"
                          placeholder="Additional notes (optional)..."></textarea>
            </div>

            <div class="idh-form-actions">
                <a asp-controller="Doctors"
                   asp-action="Dashboard"
                   class="idh-btn-secondary">
                    Cancel
                </a>

                <button type="submit" class="idh-submit-btn">Complete Visit</button>
            </div>

        </form>
    </div>

</div>
